{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CAD Wizard",
  "version": "0.0.0",
  "identifier": "io.github.cadwizard.desktop",
  "build": {
    "frontendDist": "../../app/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @cadw/app dev",
    "beforeBuildCommand": "pnpm --filter @cadw/app build"
  },
  "app": {
    "windows": [{ "title": "CAD Wizard", "width": 1280, "height": 800, "minWidth": 800, "minHeight": 500 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "Apache-2.0",
    "category": "Productivity",
    "shortDescription": "Lightweight parametric CAD",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      { "ext": ["cadw"], "name": "CAD Wizard drawing", "mimeType": "application/vnd.cadwizard+zip", "role": "Editor" }
    ]
  }
}
