{
  "name": "cad-wizard",
  "private": true,
  "version": "0.0.0",
  "description": "Lightweight, parametric, offline-capable CAD for the browser and desktop",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @cadw/app dev",
    "build": "pnpm --filter @cadw/app build",
    "preview": "pnpm --filter @cadw/app preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint:layers": "depcruise packages --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "spike:kernel-size": "python3 tools/spikes/kernel_size.py",
    "spike:step-attributes": "node tools/spikes/step-attributes.ts",
    "desktop:dev": "pnpm --filter @cadw/desktop tauri dev",
    "desktop:build": "pnpm --filter @cadw/desktop tauri build",
    "desktop:build:app": "pnpm --filter @cadw/desktop tauri build --bundles app",
    "desktop:build:dmg": "CI=true pnpm --filter @cadw/desktop tauri build --bundles app,dmg",
    "check": "pnpm typecheck && pnpm lint:layers && pnpm test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "5.0.1",
    "dependency-cruiser": "18.3.1",
    "fast-check": "4.10.2",
    "typescript": "~5.9.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
